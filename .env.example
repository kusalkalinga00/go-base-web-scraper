# API server port
PORT=9000

# Redis connection URL
REDIS_URL=redis://127.0.0.1:6379

# PostgreSQL connection URL
DATABASE_URL=postgres://scraper:scraper@127.0.0.1:5432/scraper?sslmode=disable

# Directory for extracted PDF images
PDF_IMAGES_DIR=data/pdf_images

# Optional Chromium binary path (set automatically in Docker)
# CHROME_PATH=/usr/bin/chromium

# Proxy configuration (optional)
# Supports HTTP and SOCKS5 proxies for anti-bot bypass
# PROXY_URL=http://user:pass@proxy.example.com:8080
# PROXY_HOST=proxy.example.com
# PROXY_PORT=8080
# PROXY_USERNAME=
# PROXY_PASSWORD=
# PROXY_PROTOCOL=http

PROXY_HOST=dc.decodo.com
PROXY_PORT=10001
PROXY_USERNAME=spbz97gue0
PROXY_PASSWORD=rdgZ32I88wrpGlylW_
PROXY_PROTOCOL=http


# Proxy mode: always | fallback | never
# always   - Route all requests through proxy
# fallback - Try direct first, use proxy only when blocked (default)
# never    - Never use proxy even if configured
PROXY_MODE=always

# Maximum number of concurrent worker goroutines
MAX_WORKERS=3

# Retry policy for blocked/failed browser fetches
DIRECT_RETRIES=1
PROXY_RETRIES=2
RETRY_DELAY_SECS=20

# Log level (debug, info, warn, error)
LOG_LEVEL=info
